<mxfile host="app.diagrams.net"><diagram id="arch" name="Architecture"><mxGraphModel dx="1120" dy="358" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="358" math="0" shadow="0"><root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cont" value="Every UAV (× N): its own view, its own decisions, no central planner" style="rounded=1;dashed=1;fillColor=#fffbe6;strokeColor=#b8860b;verticalAlign=top;fontStyle=1;fontSize=15;arcSize=4;" vertex="1" parent="1"><mxGeometry x="165" y="12" width="935" height="238" as="geometry"/></mxCell>
        <mxCell id="arena" value="&lt;b&gt;Search arena&lt;/b&gt;&lt;br&gt;K sectors,&lt;br&gt;one RGB +&lt;br&gt;thermal frame&lt;br&gt;per sector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.6;fontSize=15;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="10" y="50" width="120" height="152" as="geometry"/></mxCell>
        <mxCell id="perc" value="&lt;b&gt;1. Perception&lt;/b&gt;&lt;br&gt;RGB + thermal fusion&lt;br&gt;YOLO11s, 1280 px&lt;br&gt;box → sector position&lt;br&gt;alert: victim, time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=15;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="190" y="50" width="185" height="152" as="geometry"/></mxCell>
        <mxCell id="mesh" value="&lt;b&gt;2. Mesh comms&lt;/b&gt;&lt;br&gt;RF link gives PER&lt;br&gt;status msg every 5 s&lt;br&gt;per-recipient buffers&lt;br&gt;store-carry-forward" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.6;fontSize=15;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="433" y="50" width="185" height="152" as="geometry"/></mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;3. Swarm control&lt;/b&gt;&lt;br&gt;view from beacons&lt;br&gt;EW-CVT, weight w(B)&lt;br&gt;hysteresis, claims&lt;br&gt;lease failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.6;fontSize=15;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="676" y="50" width="185" height="152" as="geometry"/></mxCell>
        <mxCell id="fly" value="&lt;b&gt;Flight &amp;amp; battery&lt;/b&gt;&lt;br&gt;route over sectors&lt;br&gt;battery drain&lt;br&gt;return at 15 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.6;fontSize=15;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="919" y="50" width="160" height="152" as="geometry"/></mxCell>
